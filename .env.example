# Copy this file to .env and fill in real values. Never commit the real .env file.

# Groq API key used for the LLM calls (question routing, rewriting, answer
# generation). If set server-side, users never have to paste their own key
# into the app's sidebar. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face access token, used to download the embedding and reranker
# models. Only required if the models are gated/private or you're hitting
# HF rate limits as an anonymous client. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
